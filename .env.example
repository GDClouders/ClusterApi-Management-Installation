# Copy this file to .env and fill values. Do NOT commit .env

# Proxmox API (placeholders; examples are provided inline)
PROXMOX_URL="REPLACE_WITH_PROXMOX_URL"         # example: your_proxmox_url:8006
PROXMOX_TOKEN="REPLACE_WITH_PROXMOX_TOKEN"     # example: <your_token_id>
PROXMOX_SECRET="REPLACE_WITH_PROXMOX_SECRET"   # example: <your_token_secret>
PROXMOX_SOURCENODE="REPLACE_WITH_SOURCE_NODE"  # example: source-node-name

# VM / Template
TEMPLATE_VMID=REPLACE_WITH_TEMPLATE_VMID        # example: 901
VM_SSH_KEYS="REPLACE_WITH_YOUR_SSH_PUBLIC_KEY" # example: ssh-rsa AAAA... user@host

# Networking
CONTROL_PLANE_ENDPOINT_IP=REPLACE_WITH_CP_ENDPOINT_IP   # example: 172.16.200.110
NODE_IP_RANGES="REPLACE_WITH_NODE_IP_RANGES"          # example: [172.16.200.111-172.16.200.120]
GATEWAY=REPLACE_WITH_GATEWAY                            # example: 172.16.200.1
IP_PREFIX=REPLACE_WITH_IP_PREFIX                        # example: 24
BRIDGE=REPLACE_WITH_BRIDGE                              # example: vmbr0
DNS_SERVERS="REPLACE_WITH_DNS_SERVERS"                # example: [172.16.200.2]

# Disk / machine sizing
BOOT_VOLUME_DEVICE=REPLACE_WITH_BOOT_VOLUME_DEVICE      # example: scsi0
BOOT_VOLUME_SIZE=REPLACE_WITH_BOOT_VOLUME_SIZE          # example: 100
NUM_SOCKETS=REPLACE_WITH_NUM_SOCKETS                    # example: 2
NUM_CORES=REPLACE_WITH_NUM_CORES                        # example: 1
MEMORY_MIB=REPLACE_WITH_MEMORY_MIB                      # example: 8048

# Other optional values
# Add any additional variables required by your templates

# Calico / CNI variables (used by custom-resources.yaml)
# REPLACE_WITH placeholders; examples shown inline
CALICO_CIDR="REPLACE_WITH_CALICO_CIDR"                 # example: 192.168.0.0/16
CALICO_BLOCK_SIZE=REPLACE_WITH_CALICO_BLOCK_SIZE        # example: 26
CALICO_ENCAPSULATION="REPLACE_WITH_CALICO_ENCAPSULATION" # example: VXLANCrossSubnet
CALICO_NAT_OUTGOING="REPLACE_WITH_CALICO_NAT_OUTGOING" # example: Enabled
CALICO_NODE_SELECTOR="REPLACE_WITH_CALICO_NODE_SELECTOR" # example: all()

# Control-plane (CP) machine template variables
CP_BOOT_VOLUME_DEVICE=REPLACE_WITH_CP_BOOT_VOLUME_DEVICE   # example: scsi0
CP_BOOT_VOLUME_SIZE=REPLACE_WITH_CP_BOOT_VOLUME_SIZE       # example: 100
CP_MEMORY_MIB=REPLACE_WITH_CP_MEMORY_MIB                   # example: 8048
CP_BRIDGE=REPLACE_WITH_CP_BRIDGE                           # example: vmbr0
CP_NETWORK_MODEL=REPLACE_WITH_CP_NETWORK_MODEL             # example: virtio
CP_NUM_CORES=REPLACE_WITH_CP_NUM_CORES                     # example: 1
CP_NUM_SOCKETS=REPLACE_WITH_CP_NUM_SOCKETS                 # example: 2
CP_SOURCE_NODE=REPLACE_WITH_CP_SOURCE_NODE                 # example: nabuccodonosor
CP_TEMPLATE_ID=REPLACE_WITH_CP_TEMPLATE_ID                 # example: 901

# Worker (WK) machine template variables
WK_BOOT_VOLUME_DEVICE=REPLACE_WITH_WK_BOOT_VOLUME_DEVICE   # example: scsi0
WK_BOOT_VOLUME_SIZE=REPLACE_WITH_WK_BOOT_VOLUME_SIZE       # example: 100
WK_MEMORY_MIB=REPLACE_WITH_WK_MEMORY_MIB                   # example: 8048
WK_BRIDGE=REPLACE_WITH_WK_BRIDGE                           # example: vmbr0
WK_NETWORK_MODEL=REPLACE_WITH_WK_NETWORK_MODEL             # example: virtio
WK_NUM_CORES=REPLACE_WITH_WK_NUM_CORES                     # example: 1
WK_NUM_SOCKETS=REPLACE_WITH_WK_NUM_SOCKETS                 # example: 2
WK_SOURCE_NODE=REPLACE_WITH_WK_SOURCE_NODE                 # example: nabuccodonosor
WK_TEMPLATE_ID=REPLACE_WITH_WK_TEMPLATE_ID                 # example: 901
